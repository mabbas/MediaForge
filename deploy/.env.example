# ==============================================================================
# MediaForge / GrabItDown — Development Environment Template (.env.example)
#
# DO NOT store production or active development secrets in this file.
# Run .\scripts\Initialize-Dev.ps1 to generate a local deploy/.env with secure credentials.
# ==============================================================================

# Compose Project
COMPOSE_PROJECT_NAME=mediaforge

# --- PostgreSQL 16 Superuser ---
POSTGRES_PORT=55432
POSTGRES_DB=grabitdown
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_admin_password_here

# --- PostgreSQL Migration Role (Schema Owner / DDL) ---
GID_DB_USER=gid_user
GID_DB_PASSWORD=your_secure_gid_migrator_password_here
GID_DB_SCHEMA=gid

# --- PostgreSQL Application Runtime Role (Least-Privilege DML Only) ---
GID_APP_USER=gid_app
GID_APP_PASSWORD=your_secure_gid_app_password_here

# --- Redis 7 ---
REDIS_PORT=26379

# --- Mailpit (Local SMTP & Web UI) ---
MAILPIT_SMTP_PORT=51025
MAILPIT_WEB_PORT=58025

# --- pgAdmin 4 ---
PGADMIN_PORT=58080
PGADMIN_DEFAULT_EMAIL=admin@mediaforge.com
PGADMIN_DEFAULT_PASSWORD=your_secure_pgadmin_password_here

# --- FastAPI Application Service ---
API_PORT=58000

# --- Application Database URLs ---
# 1. Runtime Application Access (Least-Privilege DML: gid_app) - Host / Windows Dev
GID_API_DATABASE_URL=postgresql+asyncpg://gid_app:your_secure_gid_app_password_here@127.0.0.1:55432/grabitdown

# 2. Runtime Application Access (Least-Privilege DML: gid_app) - Docker Container Network
GID_APP_DOCKER_DATABASE_URL=postgresql+asyncpg://gid_app:your_secure_gid_app_password_here@postgres:5432/grabitdown

# 3. Alembic Migrations Access (Schema Owner / DDL: gid_user) - Host / Windows Dev
GID_MIGRATION_DATABASE_URL=postgresql+asyncpg://gid_user:your_secure_gid_migrator_password_here@127.0.0.1:55432/grabitdown

# 4. Standard Synchronous Fallback URL
DATABASE_URL=postgresql://gid_app:your_secure_gid_app_password_here@127.0.0.1:55432/grabitdown

# --- Security & JWT (STEP 02-B1) ---
GID_JWT_SECRET_KEY=your_cryptographically_secure_jwt_signing_key_min_32_chars
